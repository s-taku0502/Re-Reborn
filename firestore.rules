rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // users コレクション（認証済みユーザーアクセス）
    match /users/{userId} {
      // 認証されたユーザー（匿名認証を含む）は読み取り・書き込み可
      // 注: カスタム認証(userId/password)とFirebase匿名認証を併用
      allow read, write: if request.auth != null;
      
      // 管理者は読み取りのみ可（passwordHash を含む全フィールド閲覧可）
      // 注意: 管理者ツールは API 層で passwordHash を除外すること
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      
      // logs サブコレクション
      match /logs/{logId} {
        // 認証されたユーザーは読み取り・書き込み可
        allow read, write: if request.auth != null;
      }
    }

    // admins コレクション
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // contacts コレクション（管理者アクセス）
    match /contacts/{contactId} {
      allow read, update: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if true;
      allow delete: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // statistics コレクション
    match /statistics/{docId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if false;  // Cloud Functions のみ書き込み
    }

    // settings コレクション
    match /settings/{docId} {
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    // audit-logs コレクション
    match /audit-logs/{auditId} {
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
      allow write: if false;  // Cloud Functions のみ
    }

    // notifications コレクション
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
